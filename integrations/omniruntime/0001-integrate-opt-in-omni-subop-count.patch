+                auto *countState = CountState::CastState(rowStates[row] + aggStateOffset);
+                return &countState->count;
+            },
+            &result);
+        if (status == OMNI_SUBOP_COUNT_OK) {
+            return;
+        }
+        // The shared kernel makes no state change on a non-OK status.
+#endif
         ProcessGroupInternalFunctionForRawInput(rowStates, nullMap);
     } else {
         size_t rowCount = rowStates.size();
         int64_t unsedFlag = 0;
+#ifdef OMNI_SUBOP_ENABLED
+        OmniSubOpCountResult result{};
