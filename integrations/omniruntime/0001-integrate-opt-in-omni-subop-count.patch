\ No newline at end of file
+
+    // ---- Grouped shared-kernel compatibility ----
+
+    TEST(CountColumnAggregatorTest, GroupedRawCountMatchesNativeSemantics)
+    {
+        const int32_t rowCount = 6;
+        std::vector<int32_t> channels = {0};
+        auto executionContext = std::make_unique<ExecutionContext>();
+
+        auto columnAgg = CountColumnAggregatorFactory().CreateAggregator(
+            *AggregatorUtil::WrapWithDataTypes(LongType()).get(),
+            *AggregatorUtil::WrapWithDataTypes(LongType()).get(), channels, true, false, false);
+        ASSERT_NE(columnAgg, nullptr);
+        columnAgg->SetExecutionContext(executionContext.get());
+
+        auto columnState0 = NewAndInitState(columnAgg.get());
+        auto columnState1 = NewAndInitState(columnAgg.get());
+        std::vector<AggregateState *> columnStates = {
+            columnState0.get(), columnState0.get(), columnState1.get(),
+            columnState1.get(), columnState0.get(), columnState1.get()};
+
+        auto *columnValues = new Vector<int64_t>(rowCount);
+        for (int32_t row = 0; row < rowCount; ++row) {
+            columnValues->SetValue(row, row + 1);
+        }
+        columnValues->SetNull(1);
+        columnValues->SetNull(4);
+        VectorBatch *columnBatch = new VectorBatch(rowCount);
+        columnBatch->Append(columnValues);
+
+        columnAgg->ProcessGroup(columnStates, columnBatch, 0);
+        EXPECT_EQ(1, *ExtractValueFromState<int64_t>(columnState0.get()));
+        EXPECT_EQ(3, *ExtractValueFromState<int64_t>(columnState1.get()));
+        VectorHelper::FreeVecBatch(columnBatch);
+
+        auto allAgg = CountAllAggregatorFactory().CreateAggregator(
+            *AggregatorUtil::WrapWithDataTypes(NoneType()).get(),
+            *AggregatorUtil::WrapWithDataTypes(LongType()).get(), channels, true, false, false);
+        ASSERT_NE(allAgg, nullptr);
+        allAgg->SetExecutionContext(executionContext.get());
+
+        auto allState0 = NewAndInitState(allAgg.get());
+        auto allState1 = NewAndInitState(allAgg.get());
+        std::vector<AggregateState *> allStates = {
+            allState0.get(), allState0.get(), allState1.get(),
+            allState1.get(), allState0.get(), allState1.get()};
+
+        auto *anyValues = new Vector<int64_t>(rowCount);
+        for (int32_t row = 0; row < rowCount; ++row) {
+            anyValues->SetValue(row, row + 1);
+        }
+        anyValues->SetNull(1);
+        anyValues->SetNull(4);
+        VectorBatch *allBatch = new VectorBatch(rowCount);
+        allBatch->Append(anyValues);
+
+        allAgg->ProcessGroup(allStates, allBatch, 0);
+        EXPECT_EQ(3, *ExtractValueFromState<int64_t>(allState0.get()));
+        EXPECT_EQ(3, *ExtractValueFromState<int64_t>(allState1.get()));
+        VectorHelper::FreeVecBatch(allBatch);
+    }
+
+    TEST(CountColumnAggregatorTest, GroupedPartialMergeAcrossEncodings)
+    {
+        const int32_t rowCount = 6;
+        std::vector<int32_t> channels = {0};
+        auto executionContext = std::make_unique<ExecutionContext>();
+
+        auto createPartialAgg = [&]() {
+            return CountColumnAggregatorFactory().CreateAggregator(
+                *AggregatorUtil::WrapWithDataTypes(LongType()).get(),
+                *AggregatorUtil::WrapWithDataTypes(LongType()).get(), channels, false, false, false);
+        };
+
+        auto flatAgg = createPartialAgg();
+        ASSERT_NE(flatAgg, nullptr);
+        flatAgg->SetExecutionContext(executionContext.get());
+        auto flatState0 = NewAndInitState(flatAgg.get());
+        auto flatState1 = NewAndInitState(flatAgg.get());
+        std::vector<AggregateState *> flatStates = {
+            flatState0.get(), flatState0.get(), flatState1.get(),
+            flatState1.get(), flatState0.get(), flatState1.get()};
+        auto *flatValues = new Vector<int64_t>(rowCount);
+        for (int32_t row = 0; row < rowCount; ++row) {
+            flatValues->SetValue(row, row + 1);
+        }
+        flatValues->SetNull(2);
+        flatValues->SetNull(5);
+        VectorBatch *flatBatch = new VectorBatch(rowCount);
+        flatBatch->Append(flatValues);
+        flatAgg->ProcessGroup(flatStates, flatBatch, 0);
+        EXPECT_EQ(8, *ExtractValueFromState<int64_t>(flatState0.get()));
+        EXPECT_EQ(4, *ExtractValueFromState<int64_t>(flatState1.get()));
+        VectorHelper::FreeVecBatch(flatBatch);
+
+        auto constAgg = createPartialAgg();
+        ASSERT_NE(constAgg, nullptr);
+        constAgg->SetExecutionContext(executionContext.get());
+        auto constState0 = NewAndInitState(constAgg.get());
+        auto constState1 = NewAndInitState(constAgg.get());
+        std::vector<AggregateState *> constStates = {
+            constState0.get(), constState1.get(), constState0.get(), constState1.get()};
+        VectorBatch *constBatch = new VectorBatch(4);
+        constBatch->Append(new ConstVector<int64_t>(7L, OMNI_LONG, 4));
+        constAgg->ProcessGroup(constStates, constBatch, 0);
+        EXPECT_EQ(14, *ExtractValueFromState<int64_t>(constState0.get()));
+        EXPECT_EQ(14, *ExtractValueFromState<int64_t>(constState1.get()));
+        VectorHelper::FreeVecBatch(constBatch);
+
+        auto dictAgg = createPartialAgg();
+        ASSERT_NE(dictAgg, nullptr);
+        dictAgg->SetExecutionContext(executionContext.get());
+        auto dictState0 = NewAndInitState(dictAgg.get());
+        auto dictState1 = NewAndInitState(dictAgg.get());
+        std::vector<AggregateState *> dictStates = {
+            dictState0.get(), dictState1.get(), dictState0.get(), dictState1.get()};
+        auto *dictBase = new Vector<int64_t>(4);
+        for (int32_t row = 0; row < 4; ++row) {
+            dictBase->SetValue(row, row + 1);
+        }
+        int32_t ids[4] = {0, 1, 2, 3};
+        VectorBatch *dictBatch = new VectorBatch(4);
+        dictBatch->Append(CreateDictionary<OMNI_LONG>(dictBase, ids, 4));
+        dictAgg->ProcessGroup(dictStates, dictBatch, 0);
+        EXPECT_EQ(4, *ExtractValueFromState<int64_t>(dictState0.get()));
+        EXPECT_EQ(6, *ExtractValueFromState<int64_t>(dictState1.get()));
+        VectorHelper::FreeVecBatch(dictBatch);
+    }
+}
