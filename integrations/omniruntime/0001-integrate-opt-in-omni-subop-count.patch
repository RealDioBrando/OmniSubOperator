diff --git a/CMakeLists.txt b/CMakeLists.txt
index d428967b..2ccedd49 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -159,6 +159,21 @@ include_directories(SYSTEM core/src)
 include_directories(SYSTEM core)
 include_directories(${CMAKE_INSTALL_PREFIX}/lib/APL/include)
 
+option(OMNI_SUBOP_ENABLED "Enable opt-in OmniSubOperator count kernels." OFF)
+set(
+  OMNI_SUBOP_ROOT
+  ""
+  CACHE PATH
+  "Path to the OmniSubOperator source tree when OMNI_SUBOP_ENABLED is ON")
+if(OMNI_SUBOP_ENABLED)
+    if(NOT OMNI_SUBOP_ROOT)
+        message(
+          FATAL_ERROR
+          "OMNI_SUBOP_ENABLED=ON requires -DOMNI_SUBOP_ROOT=<path>")
+    endif()
+    include_directories(SYSTEM "${OMNI_SUBOP_ROOT}")
+endif()
+
 # compile library
 add_subdirectory(core)
 
diff --git a/core/src/operator/CMakeLists.txt b/core/src/operator/CMakeLists.txt
index a943cec8..18bf0640 100644
--- a/core/src/operator/CMakeLists.txt
+++ b/core/src/operator/CMakeLists.txt
@@ -6,6 +6,15 @@ file(GLOB AGG_SRC ${CMAKE_CURRENT_LIST_DIR}/aggregation/*.cpp
 list(FILTER AGG_SRC EXCLUDE REGEX "sum_int64_sve_hash_agg_sve\\.cpp$")
 add_library(op_agg_obj OBJECT ${AGG_SRC})
 
+if(OMNI_SUBOP_ENABLED)
+    target_sources(
+      op_agg_obj
+      PRIVATE
+      ${OMNI_SUBOP_ROOT}/kernel/count_batch.cpp
+      ${OMNI_SUBOP_ROOT}/kernel/version.cpp)
+    target_compile_definitions(op_agg_obj PRIVATE OMNI_SUBOP_STATIC=1 OMNI_SUBOP_ENABLED=1)
+endif()
+
 # join (join/ + join/sortmergejoin/)
 file(GLOB JOIN_SRC ${CMAKE_CURRENT_LIST_DIR}/join/*.cpp
                    ${CMAKE_CURRENT_LIST_DIR}/join/sortmergejoin/*.cpp)
