+    bool TrySharedDecimalSumRaw(std::vector<AggregateState *> &rowStates, BaseVector *vector,
+        const int32_t rowOffset, const std::shared_ptr<NullsHelper> &nullMap)
+    {
+        auto valueAt = [&](int32_t row) {
+            const int32_t vectorRow = rowOffset + row;
+            if (vector->GetEncoding() == vec::OMNI_ENCODING_CONST) {
+                return ToKernelDecimal(
+                    static_cast<vec::ConstVector<InRawType> *>(vector)->GetConstValue());
+            }
+            if (vector->GetEncoding() == vec::OMNI_DICTIONARY) {
+                auto *values = reinterpret_cast<InRawType *>(GetValuesFromDict<InDecimalId>(vector));
+                auto *indices = GetIdsFromDict<InDecimalId>(vector);
+                return ToKernelDecimal(values[indices[vectorRow]]);
+            }
+            auto *values = reinterpret_cast<InRawType *>(GetValuesFromVector<InDecimalId>(vector));
+            return ToKernelDecimal(values[vectorRow]);
+        };
+        auto nullAt = [&](int32_t row) {
+            return nullMap != nullptr && (*nullMap)[rowOffset + row] != 0;
+        };
+        auto loadStateAt = [&](int32_t row) {
+            const auto *state = SumSparkDecimalState::ConstCastState(rowStates[row] + aggStateOffset);
+            omni::subop::DecimalSumState result;
+            result.sum = ToKernelDecimal(state->value);
+            result.overflow = 0;
+            result.count = state->IsEmpty() ? 0 : (state->IsOverFlowed() ? -1 : 1);
+            result.invalid = state->IsOverFlowed();
+            return result;
+        };
+        auto storeStateAt = [&](int32_t row, omni::subop::DecimalSumState state) {
+            auto *dest = SumSparkDecimalState::CastState(rowStates[row] + aggStateOffset);
+            if constexpr (std::is_same_v<ResultType, Decimal128>) {
+                dest->value = Decimal128(state.sum);
+            } else {
+                dest->value = static_cast<ResultType>(state.sum);
+            }
+            dest->valueState = state.invalid
+                ? AggValueState::OVERFLOWED
+                : (state.count == 0 ? AggValueState::EMPTY_VALUE : AggValueState::NORMAL);
+        };
+        const auto status = omni::subop::omniruntime::DecimalSumRawGrouped(
+            rowStates,
+            aggStateOffset,
+            valueAt,
+            nullAt,
+            loadStateAt,
+            storeStateAt,
+            omni::subop::DECIMAL_SUM_STRICT_NULL,
+            nullptr);
+        return status == omni::subop::SUM_OK;
+    }
