+    template <typename T>
+    static omni::subop::DecimalInt128 ToKernelDecimal(const T &value)
+    {
+        if constexpr (std::is_same_v<T, Decimal128>) {
+            return static_cast<omni::subop::DecimalInt128>(value.ToInt128());
+        } else {
+            return static_cast<omni::subop::DecimalInt128>(value);
