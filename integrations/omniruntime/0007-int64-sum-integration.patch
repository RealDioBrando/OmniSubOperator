+TEST(SparkSumLongHashAggTest, SpillRestoreAndFinalExtraction)
+{
+    auto executionContext = std::make_unique<ExecutionContext>();
+    auto agg = MakeSparkSumLong();
+    agg->SetExecutionContext(executionContext.get());
+
+    constexpr int32_t rowCount = 4;
+    auto sourceGroups = MakeGroups(agg.get(), 2);
+    std::vector<AggregateState *> sourceRows = {
+        sourceGroups.groups[0], sourceGroups.groups[1], sourceGroups.groups[0], sourceGroups.groups[1]};
+    auto *sourceColumn = new Vector<int64_t>(rowCount);
+    sourceColumn->SetValue(0, 10);
+    sourceColumn->SetValue(1, 20);
+    sourceColumn->SetValue(2, 30);
+    sourceColumn->SetValue(3, 40);
+    auto *sourceBatch = new VectorBatch(rowCount);
+    sourceBatch->Append(sourceColumn);
+    agg->ProcessGroup(sourceRows, sourceBatch, 0);
+
+    auto *spillValues = new Vector<int64_t>(2);
+    std::vector<BaseVector *> spillVec = {spillValues};
+    agg->ExtractValuesForSpill(sourceGroups.groups, spillVec);
+    EXPECT_EQ(40, spillValues->GetValue(0));
+    EXPECT_EQ(60, spillValues->GetValue(1));
+
+    auto destinationGroups = MakeGroups(agg.get(), 2);
+    std::vector<AggregateState *> destinationRows = {
+        destinationGroups.groups[0], destinationGroups.groups[1]};
+    auto *destinationColumn = new Vector<int64_t>(2);
+    destinationColumn->SetValue(0, 5);
+    destinationColumn->SetValue(1, 7);
+    auto *destinationBatch = new VectorBatch(2);
+    destinationBatch->Append(destinationColumn);
+    agg->ProcessGroup(destinationRows, destinationBatch, 0);
+
+    auto *spillBatch = new VectorBatch(2);
+    spillBatch->Append(spillValues);
+    std::vector<UnspillRowInfo> unspillRows = {
+        UnspillRowInfo{destinationGroups.groups[0], spillBatch, 0},
+        UnspillRowInfo{destinationGroups.groups[1], spillBatch, 1}};
+    int32_t vectorIndex = 0;
+    agg->ProcessGroupUnspill(unspillRows, 2, vectorIndex);
+    EXPECT_EQ(1, vectorIndex);
+
+    auto *out0 = new Vector<int64_t>(1);
+    auto *out1 = new Vector<int64_t>(1);
+    std::vector<BaseVector *> extract0 = {out0};
+    std::vector<BaseVector *> extract1 = {out1};
+    agg->ExtractValues(destinationGroups.groups[0], extract0, 0);
+    agg->ExtractValues(destinationGroups.groups[1], extract1, 0);
+    EXPECT_EQ(45, out0->GetValue(0));
+    EXPECT_EQ(67, out1->GetValue(0));
+
+    VectorHelper::FreeVecBatch(spillBatch);
+    VectorHelper::FreeVecBatch(destinationBatch);
+    VectorHelper::FreeVecBatch(sourceBatch);
+    delete out0;
+    delete out1;
+}
