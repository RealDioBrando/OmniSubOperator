+#ifdef OMNI_SUBOP_ENABLED
+    bool TrySharedSumSingle(
+        AggregateState *state,
+        BaseVector *vector,
+        int32_t rowOffset,
+        int32_t rowCount,
+        const std::shared_ptr<NullsHelper> &nullMap) {
+        if constexpr (IN_ID != OMNI_LONG || OUT_ID != OMNI_LONG) {
+            return false;
+        }
+        SumFlatState *sumState = SumFlatState::CastState(state + aggStateOffset);
+        if (sumState->valueState == AggValueState::OVERFLOWED) {
+            return false;
+        }
+        auto valueAt = [&](int32_t row) {
+            const auto vectorRow = rowOffset + row;
+            if (vector->GetEncoding() == vec::OMNI_ENCODING_CONST) {
+                return static_cast<int64_t>(static_cast<vec::ConstVector<InType> *>(vector)->GetConstValue());
+            }
+            if (vector->GetEncoding() == vec::OMNI_DICTIONARY) {
+                auto *values = reinterpret_cast<InType *>(GetValuesFromDict<IN_ID>(vector));
+                auto *indices = GetIdsFromDict<IN_ID>(vector);
+                return static_cast<int64_t>(values[indices[vectorRow]]);
+            }
+            auto *values = reinterpret_cast<InType *>(GetValuesFromVector<IN_ID>(vector));
+            return static_cast<int64_t>(values[vectorRow]);
+        };
+        auto nullAt = [&](int32_t row) {
+            return nullMap != nullptr && (*nullMap)[row] != 0;
+        };
+        const bool initialized = sumState->valueState != AggValueState::EMPTY_VALUE;
+        bool newInitialized = initialized;
+        const auto status = omni::subop::omniruntime::SumRawSingleGroup(
+            rowCount, valueAt, nullAt, &sumState->value, initialized, &newInitialized, nullptr);
+        if (status != omni::subop::SUM_OK) {
+            return false;
+        }
+        if (newInitialized) {
+            sumState->valueState = AggValueState::NORMAL;
+        }
+        return true;
+    }
+
+    bool TrySharedSumRaw(
+        std::vector<AggregateState *> &rowStates,
+        BaseVector *vector,
+        int32_t rowOffset,
+        const std::shared_ptr<NullsHelper> &nullMap) {
+        if constexpr (IN_ID != OMNI_LONG || OUT_ID != OMNI_LONG) {
+            return false;
+        }
+        const auto rowCount = static_cast<int32_t>(rowStates.size());
+        for (auto *base : rowStates) {
+            if (SumFlatState::CastState(base + aggStateOffset)->valueState == AggValueState::OVERFLOWED) {
+                return false;
+            }
+        }
+        auto valueAt = [&](int32_t row) {
+            const auto vectorRow = rowOffset + row;
+            if (vector->GetEncoding() == vec::OMNI_ENCODING_CONST) {
+                return static_cast<int64_t>(static_cast<vec::ConstVector<InType> *>(vector)->GetConstValue());
+            }
+            if (vector->GetEncoding() == vec::OMNI_DICTIONARY) {
+                auto *values = reinterpret_cast<InType *>(GetValuesFromDict<IN_ID>(vector));
+                auto *indices = GetIdsFromDict<IN_ID>(vector);
+                return static_cast<int64_t>(values[indices[vectorRow]]);
+            }
+            auto *values = reinterpret_cast<InType *>(GetValuesFromVector<IN_ID>(vector));
+            return static_cast<int64_t>(values[vectorRow]);
+        };
+        auto nullAt = [&](int32_t row) {
+            return nullMap != nullptr && (*nullMap)[row] != 0;
+        };
+        auto stateValueAt = [&](int32_t row) {
+            return &SumFlatState::CastState(rowStates[row] + aggStateOffset)->value;
+        };
+        auto initializedAt = [&](int32_t row) {
+            return SumFlatState::CastState(rowStates[row] + aggStateOffset)->valueState !=
+                AggValueState::EMPTY_VALUE;
+        };
+        auto markAt = [&](int32_t row) {
+            auto *state = SumFlatState::CastState(rowStates[row] + aggStateOffset);
+            if (state->valueState == AggValueState::EMPTY_VALUE) {
+                state->valueState = AggValueState::NORMAL;
+            }
+        };
+        return omni::subop::omniruntime::SumRawGrouped(
+            rowCount, valueAt, nullAt, stateValueAt, initializedAt, markAt, nullptr) ==
+            omni::subop::SUM_OK;
+    }
