diff --git a/core/test/operator/aggregator/spark_sum_long_hash_agg_test.cpp b/core/test/operator/aggregator/spark_sum_long_hash_agg_test.cpp
index d889b5f..97d910a 100644
--- a/core/test/operator/aggregator/spark_sum_long_hash_agg_test.cpp
+++ b/core/test/operator/aggregator/spark_sum_long_hash_agg_test.cpp
@@ -428,4 +428,26 @@ TEST(SparkSumLongHashAggTest, MixedStateSerdeEmptyNormalOverflow)
     EXPECT_TRUE(out->IsNull(2));
     delete out;
 }
+#ifdef OMNI_SUBOP_ENABLED
+TEST(SparkSumLongHashAggTest, SharedKernelNullStateIsFatal)
+{
+    auto executionContext = std::make_unique<ExecutionContext>();
+    auto agg = MakeSparkSumLong();
+    ASSERT_NE(agg, nullptr);
+    agg->SetExecutionContext(executionContext.get());
+
+    auto groups = MakeGroups(agg.get(), 1);
+    std::vector<AggregateState *> rowStates = {groups.groups[0], nullptr};
+    auto *column = new Vector<int64_t>(2);
+    column->SetValue(0, 5);
+    column->SetValue(1, 7);
+    auto *batch = new VectorBatch(2);
+    batch->Append(column);
+
+    EXPECT_THROW(agg->ProcessGroup(rowStates, batch, 0),
+        omniruntime::exception::OmniException);
+    VectorHelper::FreeVecBatch(batch);
+}
+
+#endif
 } // namespace omniruntime
