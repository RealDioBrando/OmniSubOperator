+            *AggregatorUtil::WrapWithDataTypes(NoneType()).get(),
+            *AggregatorUtil::WrapWithDataTypes(LongType()).get(), channels, true, false, false);
+        ASSERT_NE(agg, nullptr);
+        agg->SetExecutionContext(executionContext.get());
+
+        auto state0 = NewAndInitState(agg.get());
+        auto state1 = NewAndInitState(agg.get());
+        std::vector<AggregateState *> rowStates = {
+            state0.get(), state1.get(), state0.get(), state1.get(), state0.get(), state1.get()};
+        VectorBatch *batch = new VectorBatch(rowCount);
+        batch->Append(BuildCountInputColumn(LongType(), rowCount, rowCount));
+        auto *filter = new Vector<bool>(rowCount);
+        const bool selected[rowCount] = {true, false, true, true, false, false};
+        for (int32_t row = 0; row < rowCount; ++row) {
+            filter->SetValue(row, selected[row]);
+        }
+        batch->Append(filter);
+
+        agg->ProcessGroupFilter(rowStates, 0, batch, 1, 0);
+        EXPECT_EQ(2, *ExtractValueFromState<int64_t>(state0.get()));
