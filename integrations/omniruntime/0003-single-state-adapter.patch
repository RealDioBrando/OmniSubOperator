+    TEST(CountColumnAggregatorTest, CountAllSingleGroupHonorsFilterMask)
+    {
+        constexpr int32_t rowCount = 6;
+        auto executionContext = std::make_unique<ExecutionContext>();
+        std::vector<int32_t> channels = {-1};
+        auto agg = CountAllAggregatorFactory().CreateAggregator(
+            *AggregatorUtil::WrapWithDataTypes(NoneType()).get(),
+            *AggregatorUtil::WrapWithDataTypes(LongType()).get(), channels, true, false, false);
+        ASSERT_NE(agg, nullptr);
+        agg->SetExecutionContext(executionContext.get());
+
+        auto state = NewAndInitState(agg.get());
+        VectorBatch *batch = new VectorBatch(rowCount);
+        batch->Append(BuildCountInputColumn(LongType(), rowCount, rowCount));
+        auto *filter = new Vector<bool>(rowCount);
+        for (int32_t row = 0; row < rowCount; ++row) {
+            filter->SetValue(row, row % 2 == 0);
+        }
+        batch->Append(filter);
+
+        agg->ProcessGroupFilter(state.get(), batch, 0, 1);
+        EXPECT_EQ(3, *ExtractValueFromState<int64_t>(state.get()));
+        VectorHelper::FreeVecBatch(batch);
+    }
+
+    TEST(CountColumnAggregatorTest, CountAllGroupedHonorsFilterMask)
+    {
+        constexpr int32_t rowCount = 6;
+        auto executionContext = std::make_unique<ExecutionContext>();
+        std::vector<int32_t> channels = {-1};
