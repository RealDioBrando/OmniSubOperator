+        VectorBatch *batch = new VectorBatch(1);
+        batch->Append(new ConstVector<int64_t>(1L, OMNI_LONG, 1));
+
+        *value = -1;
+        EXPECT_THROW(agg->ProcessGroup(state.get(), batch, 0, 1),
