+TEST_F(CountAggregateIntegrationTest, rejectsInvalidStateAndOverflow) {
+  facebook::velox::SelectivityVector rows(1);
+  rows.setAll();
+  std::vector<char*> groups(1);
+  std::vector<facebook::velox::VectorPtr> noArgs;
+  OmniSubOpCountResult result{};
+
+  int64_t state = -1;
+  groups[0] = reinterpret_cast<char*>(&state);
+  EXPECT_EQ(
+      omni::subop::velox::CountRawBatch(groups.data(), rows, noArgs, 0, &result),
+      OMNI_SUBOP_COUNT_INVALID_STATE);
+  EXPECT_EQ(state, -1);
+
+  state = std::numeric_limits<int64_t>::max();
+  EXPECT_EQ(
+      omni::subop::velox::CountRawBatch(groups.data(), rows, noArgs, 0, &result),
+      OMNI_SUBOP_COUNT_OVERFLOW);
+  EXPECT_EQ(state, std::numeric_limits<int64_t>::max());
+
+  state = 0;
+  auto invalidPartial = makeFlatVector<int64_t>(1, [](auto) { return -1; });
+  std::vector<facebook::velox::VectorPtr> mergeArgs{invalidPartial};
+  EXPECT_EQ(
+      omni::subop::velox::CountMergeBatch(groups.data(), rows, mergeArgs, 0, &result),
+      OMNI_SUBOP_COUNT_INVALID_STATE);
+  EXPECT_EQ(state, 0);
+}
+
 } // namespace
