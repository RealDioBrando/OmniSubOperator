+  void addIntermediateResults(
+      char** groups,
+      const SelectivityVector& rows,
+      const std::vector<VectorPtr>& args,
+      bool mayPushdown) override {
+#ifdef VELOX_ENABLE_OMNI_SUBOP_SUM
+    if (useOmniSubOpSum_) {
+      const auto status = omni::subop::velox::DecimalSumMergeBatch<
+          TSumType,
+          AccumulatorType>(
+          groups, rows, args, this->offset_, nullptr);
+      if (status == omni::subop::SUM_OK) {
+        return;
+      }
+      if (status != omni::subop::SUM_INVALID_ARGUMENT &&
+          status != omni::subop::SUM_UNSUPPORTED) {
+        VELOX_FAIL(
+            "OmniSubOperator decimal partial merge failed with status {}",
+            status);
+      }
+    }
+#endif
+    Base::addIntermediateResults(groups, rows, args, mayPushdown);
+  }
+
+  void addSingleGroupIntermediateResults(
+      char* group,
+      const SelectivityVector& rows,
+      const std::vector<VectorPtr>& args,
+      bool mayPushdown) override {
+#ifdef VELOX_ENABLE_OMNI_SUBOP_SUM
+    if (useOmniSubOpSum_) {
+      std::vector<char*> groupRows(
+          static_cast<size_t>(rows.size()), group);
+      const auto status = omni::subop::velox::DecimalSumMergeBatch<
+          TSumType,
+          AccumulatorType>(
+          groupRows.data(), rows, args, this->offset_, nullptr);
+      if (status == omni::subop::SUM_OK) {
+        return;
+      }
+      if (status != omni::subop::SUM_INVALID_ARGUMENT &&
+          status != omni::subop::SUM_UNSUPPORTED) {
+        VELOX_FAIL(
+            "OmniSubOperator decimal single-group partial merge failed with "
+            "status {}",
+            status);
+      }
+    }
+#endif
+    Base::addSingleGroupIntermediateResults(
+        group, rows, args, mayPushdown);
   }
 
