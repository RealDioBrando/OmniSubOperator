+TEST_F(SumAggregateIntegrationTest, decimalRawGrouped) {
+  constexpr vector_size_t kRows = 24;
+  auto groups = makeFlatVector<int32_t>(
+      kRows, [](auto row) { return static_cast<int32_t>(row % 4); });
+  auto shortValues = makeNullableFlatVector<int64_t>(
+      {1000,
+       250,
+       std::nullopt,
+       -300,
+       4500,
+       0,
+       7000,
+       -1250,
+       200,
+       std::nullopt,
+       3300,
+       -100,
+       5000,
+       150,
+       2200,
+       -400,
+       9000,
+       75,
+       std::nullopt,
+       6400,
+       -800,
+       1200,
+       0,
+       3100},
+      DECIMAL(10, 2));
+  auto longValues = makeNullableFlatVector<int128_t>(
+      {static_cast<int128_t>(100000000),
+       static_cast<int128_t>(250000),
+       static_cast<int128_t>(-300000),
+       std::nullopt,
+       static_cast<int128_t>(4500000),
+       static_cast<int128_t>(0),
+       static_cast<int128_t>(700000000),
+       static_cast<int128_t>(-1250000),
+       static_cast<int128_t>(200000),
+       static_cast<int128_t>(3300000),
+       static_cast<int128_t>(-100000),
+       static_cast<int128_t>(500000),
+       static_cast<int128_t>(150000),
+       static_cast<int128_t>(2200000),
+       static_cast<int128_t>(-400000),
+       static_cast<int128_t>(900000),
+       static_cast<int128_t>(75000),
+       static_cast<int128_t>(6400000),
+       static_cast<int128_t>(-800000),
+       static_cast<int128_t>(1200000),
+       static_cast<int128_t>(0),
+       static_cast<int128_t>(3100000),
+       static_cast<int128_t>(1000),
+       static_cast<int128_t>(-2000)},
+      DECIMAL(23, 4));
+  std::vector<RowVectorPtr> data{makeRowVector({groups, shortValues, longValues})};
+  createDuckDbTable(data);
+
+  testBothPaths(
+      data,
+      {"c0"},
+      {"spark_sum(c1)", "spark_sum(c2)"},
+      "SELECT c0, sum(c1), sum(c2) FROM tmp GROUP BY c0");
+}
