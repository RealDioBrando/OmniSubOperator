+#include "velox/exec/tests/utils/AssertQueryBuilder.h"
+#include "velox/exec/tests/utils/PlanBuilder.h"
+#include "velox/functions/lib/aggregates/tests/utils/AggregationTestBase.h"
+#include "velox/functions/sparksql/aggregates/Register.h"
+
+using namespace facebook::velox::exec::test;
+using namespace facebook::velox::functions::aggregate::test;
+
+namespace facebook::velox::functions::aggregate::sparksql::test {
+
+namespace {
+constexpr const char* kKernelConfig = "omni_subop.minmax_enabled";
+
+class MinMaxAggregateIntegrationTest : public AggregationTestBase {
+ protected:
+  void SetUp() override {
+    AggregationTestBase::SetUp();
+    registerAggregateFunctions("spark_", true);
+  }
+
+  void testBothPaths(
+      const std::vector<RowVectorPtr>& data,
+      const std::vector<std::string>& groupingKeys,
+      const std::vector<std::string>& aggregates,
+      const std::string& duckDbSql) {
+    for (const auto* enabled : {"false", "true"}) {
+      testAggregations(
+          data,
+          groupingKeys,
+          aggregates,
+          duckDbSql,
+          {{kKernelConfig, enabled}});
+    }
+  }
+};
+} // namespace
+
+TEST_F(MinMaxAggregateIntegrationTest, int64GroupedRaw) {
+  constexpr vector_size_t kRows = 32;
+  auto groups = makeFlatVector<int32_t>(
+      kRows, [](auto row) { return static_cast<int32_t>(row % 4); });
+  std::vector<std::optional<int64_t>> valueRows;
+  valueRows.reserve(kRows);
+  for (vector_size_t row = 0; row < kRows; ++row) {
+    valueRows.emplace_back(
+        row % 7 == 0 ? std::nullopt : std::optional<int64_t>(row - 16));
+  }
+  auto values = makeNullableFlatVector<int64_t>(valueRows);
+  auto dictionaryBase = makeNullableFlatVector<int64_t>({9, -2, 4, 4});
+  auto dictionary = BaseVector::wrapInDictionary(
+      nullptr,
+      makeIndices(kRows, [](auto row) { return static_cast<vector_size_t>(row % 4); }),
+      kRows,
+      dictionaryBase);
+  auto constant = BaseVector::createConstant(BIGINT(), int64_t(13), kRows, pool());
+  std::vector<RowVectorPtr> data{
+      makeRowVector({groups, values, dictionary, constant})};
+  createDuckDbTable(data);
+
+  testBothPaths(
+      data,
+      {"c0"},
+      {"spark_min(c1)", "spark_max(c1)", "spark_min(c2)", "spark_max(c2)",
+       "spark_min(c3)", "spark_max(c3)"},
+      "SELECT c0, min(c1), max(c1), min(c2), max(c2), min(c3), max(c3) "
+      "FROM tmp GROUP BY c0");
+}
+
+TEST_F(MinMaxAggregateIntegrationTest, int64SparseSelection) {
+  constexpr vector_size_t kRows = 40;
+  auto groups = makeFlatVector<int32_t>(
+      kRows, [](auto row) { return static_cast<int32_t>(row % 5); });
+  auto values = makeFlatVector<int64_t>(
+      kRows, [](auto row) { return static_cast<int64_t>(row - 20); });
+  std::vector<RowVectorPtr> data{makeRowVector({groups, values})};
+  createDuckDbTable(data);
+
+  auto makeSource = [&](PlanBuilder& builder) {
+    builder.values(data).filter("c0 % 2 = 0");
+  };
+  for (const auto* enabled : {"false", "true"}) {
+    testAggregations(
+        makeSource,
+        {"c0"},
+        {"spark_min(c1)", "spark_max(c1)"},
+        "SELECT c0, min(c1), max(c1) FROM tmp WHERE c0 % 2 = 0 GROUP BY c0",
+        {{kKernelConfig, enabled}});
+  }
+}
+
+} // namespace facebook::velox::functions::aggregate::sparksql::test
