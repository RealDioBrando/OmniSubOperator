+        *status = omni::subop::SUM_OVERFLOW;
+      }));
+
+  testFailingAggregations(
+      data,
+      {"c0"},
+      {"spark_sum(c1)"},
+      "OmniSubOperator int64 sum kernel failed with status -4",
+      {{kKernelConfig, "true"}});
+  EXPECT_GT(injections.load(), 0);
+}
