+TEST_F(SumAggregateIntegrationTest, decimalInjectedFallbackIsAppliedOnce) {
+  constexpr vector_size_t kRows = 12;
+  auto groups = makeFlatVector<int32_t>(
+      kRows, [](auto row) { return static_cast<int32_t>(row % 3); });
+  auto values = makeNullableFlatVector<int64_t>(
+      {100,
+       std::nullopt,
+       -300,
+       400,
+       std::nullopt,
+       -600,
+       700,
+       800,
+       std::nullopt,
+       -1000,
+       1100,
+       1200},
+      DECIMAL(10, 2));
+  std::vector<RowVectorPtr> data{makeRowVector({groups, values})};
+  createDuckDbTable(data);
+
+  for (const auto injectedStatus :
+       {omni::subop::SUM_UNSUPPORTED, omni::subop::SUM_INVALID_ARGUMENT}) {
+    std::atomic<int32_t> injections{0};
+    SCOPED_TESTVALUE_SET(
+        kDecimalBeforeAdapter,
+        std::function<void(int32_t*)>([&](int32_t* status) {
+          ++injections;
+          *status = injectedStatus;
+        }));
+
+    testAggregations(
+        data,
+        {"c0"},
+        {"spark_sum(c1)"},
+        "SELECT c0, sum(c1) FROM tmp GROUP BY c0",
+        {{kKernelConfig, "true"}});
+    EXPECT_GT(injections.load(), 0);
+  }
+}
