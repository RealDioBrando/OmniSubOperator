+        kRows, [](auto row) { return static_cast<int32_t>(row % kGroups); });
+    auto values = makeFlatVector<int64_t>(
+        kRows,
+        [](auto row) { return static_cast<int64_t>(row * 3 - 1000); },
+        [](auto row) { return row % 11 == 0; },
+        BIGINT());
+    auto decimals = makeFlatVector<int64_t>(
+        kRows,
+        [](auto row) { return static_cast<int64_t>(row * 10 - 1000); },
+        [](auto row) { return row % 13 == 0; },
+        DECIMAL(10, 2));
+    data_ = makeRowVector({groups, values, decimals});
+
+    makePlans([&](PlanBuilder& builder) { builder.values({data_}); });
+
+    filePath_ = TempFilePath::create();
+    writeToFile(filePath_->getPath(), data_);
+    const auto hiveSplits = makeHiveConnectorSplits(
+        filePath_->getPath(),
+        kScanSplits,
+        dwio::common::FileFormat::DWRF);
+    splits_.insert(splits_.end(), hiveSplits.begin(), hiveSplits.end());
+    makeScanPlans(
+        [&](PlanBuilder& builder) { builder.tableScan(inputType_); });
+  }
+
+  ~OmniSubOpAggregateBenchmark() override {
+    splits_.clear();
+    filePath_.reset();
+    data_.reset();
+    clearPlans();
+    HiveConnectorTestBase::TearDown();
+  }
+
+  void TestBody() override {}
+
+  void runSuite() {
+    std::cout << "scenario,off_ms,on_ms,off_over_on\n";
+    report("values_count_groupby", [&](bool enabled) {
+      runValues(countPlan_, "omni_subop.count_enabled", enabled);
+    });
+    report("values_int64_sum_groupby", [&](bool enabled) {
+      runValues(sumPlan_, "omni_subop.sum_enabled", enabled);
+    });
+    report("values_decimal_sum_groupby", [&](bool enabled) {
+      runValues(decimalSumPlan_, "omni_subop.sum_enabled", enabled);
+    });
+    report("values_int64_minmax_groupby", [&](bool enabled) {
+      runValues(minMaxPlan_, "omni_subop.minmax_enabled", enabled);
+    });
+
+    report("scan4_count_groupby", [&](bool enabled) {
+      runScan(scanCountPlan_, scanCountId_, "omni_subop.count_enabled", enabled);
+    });
+    report("scan4_int64_sum_groupby", [&](bool enabled) {
+      runScan(scanSumPlan_, scanSumId_, "omni_subop.sum_enabled", enabled);
+    });
+    report("scan4_decimal_sum_groupby", [&](bool enabled) {
+      runScan(scanDecimalSumPlan_, scanDecimalSumId_, "omni_subop.sum_enabled", enabled);
+    });
+    report("scan4_int64_minmax_groupby", [&](bool enabled) {
+      runScan(scanMinMaxPlan_, scanMinMaxId_, "omni_subop.minmax_enabled", enabled);
+    });
+  }
+
+ private:
+  void verifyScanPlan(
+      const core::PlanFragment& plan,
+      const core::PlanNodeId& scanId,
+      const std::string& configKey) {
+    const auto off = AssertQueryBuilder(plan.planNode)
+                         .maxDrivers(std::max(1, FLAGS_benchmark_scan_drivers))
+                         .config(configKey, "false")
+                         .splits(scanId, splits_)
+                         .copyResults(pool_.get());
+    const auto on = AssertQueryBuilder(plan.planNode)
+                        .maxDrivers(std::max(1, FLAGS_benchmark_scan_drivers))
+                        .config(configKey, "true")
+                        .splits(scanId, splits_)
+                        .copyResults(pool_.get());
+    assertEqualResults({off}, {on});
+  }
+
+  void makePlans(const std::function<void(PlanBuilder&)>& source) {
+    countPlan_ = buildPlan(source, {"spark_count()"});
+    sumPlan_ = buildPlan(source, {"spark_sum(c1)"});
+    decimalSumPlan_ = buildPlan(source, {"spark_sum(c2)"});
+    minMaxPlan_ = buildPlan(source, {"spark_min(c1)", "spark_max(c1)"});
+  }
+
+  void makeScanPlans(const std::function<void(PlanBuilder&)>& source) {
+    scanCountPlan_ = buildPlan(source, {"spark_count()"}, &scanCountId_);
+    scanSumPlan_ = buildPlan(source, {"spark_sum(c1)"}, &scanSumId_);
+    scanDecimalSumPlan_ = buildPlan(source, {"spark_sum(c2)"}, &scanDecimalSumId_);
+    scanMinMaxPlan_ = buildPlan(source, {"spark_min(c1)", "spark_max(c1)"}, &scanMinMaxId_);
+  }
+
+  core::PlanFragment buildPlan(
+      const std::function<void(PlanBuilder&)>& source,
+      const std::vector<std::string>& aggregates,
+      core::PlanNodeId* scanId = nullptr) {
+    PlanBuilder builder;
+    source(builder);
+    if (scanId != nullptr) {
+      builder.capturePlanNodeId(*scanId);
+    }
+    return builder.partialAggregation({"c0"}, aggregates)
+        .finalAggregation()
+        .planFragment();
+  }
+
+  void clearPlans() {
+    countPlan_ = core::PlanFragment{};
+    sumPlan_ = core::PlanFragment{};
+    decimalSumPlan_ = core::PlanFragment{};
+    minMaxPlan_ = core::PlanFragment{};
+    scanCountPlan_ = core::PlanFragment{};
+    scanSumPlan_ = core::PlanFragment{};
+    scanDecimalSumPlan_ = core::PlanFragment{};
+    scanMinMaxPlan_ = core::PlanFragment{};
+  }
+
+  void report(
+      const std::string& name,
+      const std::function<void(bool)>& scenario) {
+    const auto off = measure(scenario, false);
+    const auto on = measure(scenario, true);
+    std::cout << name << ',' << std::fixed << std::setprecision(3) << off
+              << ',' << on << ',' << (on == 0 ? 0 : off / on) << '\n';
+  }
+
+  double measure(
+      const std::function<void(bool)>& scenario,
+      bool enabled) {
+    scenario(enabled);
+    const int32_t repeats = std::max(1, FLAGS_benchmark_repeats);
+    std::vector<double> samples;
+    samples.reserve(repeats);
+    for (int32_t repeat = 0; repeat < repeats; ++repeat) {
+      const auto begin = std::chrono::steady_clock::now();
+      scenario(enabled);
+      const auto end = std::chrono::steady_clock::now();
+      samples.push_back(
+          std::chrono::duration<double, std::milli>(end - begin).count());
+    }
+    std::sort(samples.begin(), samples.end());
+    return samples[samples.size() / 2];
+  }
+
+  void runValues(
+      const core::PlanFragment& plan,
+      const std::string& configKey,
+      bool enabled) {
+    auto task = makeTask(plan, configKey, enabled, exec::Task::ExecutionMode::kSerial);
+    drain(task);
+  }
+
+  void runScan(
+      const core::PlanFragment& plan,
+      const core::PlanNodeId& scanId,
+      const std::string& configKey,
+      bool enabled) {
+    exec::CursorParameters params;
+    params.planNode = plan.planNode;
+    params.maxDrivers = std::max(1, FLAGS_benchmark_scan_drivers);
+    params.queryConfigs = {{configKey, enabled ? "true" : "false"}};
+    auto cursor = exec::TaskCursor::create(params);
+    for (const auto& split : splits_) {
+      auto connectorSplit = split;
+      cursor->task()->addSplit(
+          scanId, exec::Split(std::move(connectorSplit)));
+    }
+    cursor->task()->noMoreSplits(scanId);
+
+    int64_t resultRows = 0;
+    while (cursor->moveNext()) {
+      resultRows += cursor->current()->size();
+    }
+    folly::doNotOptimizeAway(resultRows);
+  }
+
+  std::shared_ptr<exec::Task> makeTask(
+      const core::PlanFragment& plan,
+      const std::string& configKey,
+      bool enabled,
+      exec::Task::ExecutionMode mode) {
+    std::unordered_map<std::string, std::string> config{
+        {configKey, enabled ? "true" : "false"}};
+    auto queryCtx = core::QueryCtx::create(
+        executor_.get(), core::QueryConfig{std::move(config)});
+    return exec::Task::create(
+        "omni-subop-benchmark-" + std::to_string(++taskId_),
+        plan,
+        0,
+        queryCtx,
+        mode);
+  }
+
+  static void drain(const std::shared_ptr<exec::Task>& task) {
+    int64_t resultRows = 0;
+    while (auto result = task->next()) {
+      resultRows += result->size();
+    }
+    folly::doNotOptimizeAway(resultRows);
+  }
+
+  RowTypePtr inputType_;
+  RowVectorPtr data_;
+  std::shared_ptr<TempFilePath> filePath_;
+  std::vector<std::shared_ptr<connector::ConnectorSplit>> splits_;
+  core::PlanFragment countPlan_;
+  core::PlanFragment sumPlan_;
+  core::PlanFragment decimalSumPlan_;
+  core::PlanFragment minMaxPlan_;
+  core::PlanFragment scanCountPlan_;
+  core::PlanFragment scanSumPlan_;
+  core::PlanFragment scanDecimalSumPlan_;
+  core::PlanFragment scanMinMaxPlan_;
+  core::PlanNodeId scanCountId_;
+  core::PlanNodeId scanSumId_;
+  core::PlanNodeId scanDecimalSumId_;
+  core::PlanNodeId scanMinMaxId_;
+  int32_t taskId_{0};
+};
+
+} // namespace
+
+int main(int argc, char** argv) {
+  folly::Init init(&argc, &argv);
+
+  OperatorTestBase::SetUpTestCase();
+  auto benchmark = std::make_unique<OmniSubOpAggregateBenchmark>();
+  benchmark->runSuite();
+  benchmark.reset();
+  OperatorTestBase::TearDownTestCase();
+  return 0;
+}
