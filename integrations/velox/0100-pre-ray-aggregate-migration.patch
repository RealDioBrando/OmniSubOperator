+TEST_F(CountAggregateIntegrationTest, filteredCountStar) {
+  constexpr vector_size_t kRows = 30;
+  auto groups = makeFlatVector<int32_t>(
+      kRows, [](auto row) { return static_cast<int32_t>(row % 5); });
+  std::vector<std::optional<int64_t>> valueRows;
+  valueRows.reserve(kRows);
+  for (vector_size_t row = 0; row < kRows; ++row) {
+    valueRows.emplace_back(
+        row % 4 == 0 ? std::nullopt
+                     : std::optional<int64_t>(row - 10));
+  }
+  auto values = makeNullableFlatVector<int64_t>(valueRows);
+  auto mask = makeFlatVector<bool>(
+      kRows, [](auto row) { return row % 3 != 0; });
+  std::vector<RowVectorPtr> data{makeRowVector({groups, values, mask})};
+  createDuckDbTable(data);
+
+  const std::vector<
+      std::tuple<std::vector<std::string>, std::vector<std::string>, std::string>>
+      cases{
+          {{"spark_count()"},
+           {"c2"},
+           "SELECT count(1) FILTER (WHERE c2) FROM tmp"},
+          {{"spark_count(c1)"},
+           {"c2"},
+           "SELECT count(c1) FILTER (WHERE c2) FROM tmp"},
+          {{"spark_count()", "spark_count(c1)"},
+           {"c2", "c2"},
+           "SELECT count(1) FILTER (WHERE c2), "
+           "count(c1) FILTER (WHERE c2) FROM tmp"},
+      };
+
+  for (const auto* enabled : {"false", "true"}) {
+    for (const auto& [aggregates, masks, sql] : cases) {
+      SCOPED_TRACE(std::string(kKernelConfig) + "=" + enabled);
+      auto single = PlanBuilder()
+                        .values(data)
+                        .singleAggregation({}, aggregates, masks)
+                        .planNode();
+      AssertQueryBuilder(single, duckDbQueryRunner_)
+          .config(kKernelConfig, enabled)
+          .assertResults(sql);
+
+      auto partialFinal = PlanBuilder()
+                              .values(data)
+                              .partialAggregation({}, aggregates, masks)
+                              .finalAggregation()
+                              .planNode();
+      AssertQueryBuilder(partialFinal, duckDbQueryRunner_)
+          .config(kKernelConfig, enabled)
+          .assertResults(sql);
+    }
+
+    auto grouped = PlanBuilder()
+                       .values(data)
+                       .partialAggregation({"c0"}, {"spark_count()"}, {"c2"})
