+        ++injections;
+        *status = omni::subop::SUM_INVALID_STATE;
+      }));
+
+  testFailingAggregations(
+      data,
+      {"c0"},
+      {"spark_sum(c1)"},
+      "OmniSubOperator decimal sum kernel failed with status -3",
