+TEST_F(CountAggregateIntegrationTest, rawAndPartialMerge) {
+  constexpr vector_size_t kRows = 32;
+  auto groups = makeFlatVector<int32_t>(
+      kRows, [](auto row) { return static_cast<int32_t>(row % 4); });
+  auto values = makeNullableFlatVector<int64_t>(
+      {0,
+       1,
+       std::nullopt,
+       3,
+       4,
+       std::nullopt,
+       6,
+       7,
+       8,
+       std::nullopt,
+       10,
+       11,
+       12,
+       13,
+       std::nullopt,
+       15,
+       16,
+       17,
+       18,
+       std::nullopt,
+       20,
+       21,
+       22,
+       23,
+       std::nullopt,
+       25,
+       26,
+       27,
+       28,
+       29,
+       std::nullopt,
+       31});
+  auto dictionaryBase =
+      makeNullableFlatVector<int64_t>({1, std::nullopt, 3, 4});
+  auto dictionary = BaseVector::wrapInDictionary(
+      nullptr,
+      makeIndices(
+          kRows, [](auto row) { return static_cast<vector_size_t>(row % 4); }),
+      kRows,
+      dictionaryBase);
+  auto constant =
+      BaseVector::createConstant(BIGINT(), int64_t(9), kRows, pool());
+  auto nullConstant = BaseVector::createNullConstant(BIGINT(), kRows, pool());
+  std::vector<RowVectorPtr> data{
+      makeRowVector({groups, values, dictionary, constant, nullConstant})};
+  createDuckDbTable(data);
+
+  testBothPaths(
+      data,
+      {},
+      {"spark_count()",
+       "spark_count(c1)",
+       "spark_count(c2)",
+       "spark_count(c3)",
+       "spark_count(c4)"},
+      "SELECT count(1), count(c1), count(c2), count(c3), count(c4) "
+      "FROM tmp");
+
+  testBothPaths(
+      data,
+      {"c0"},
+      {"spark_count()",
+       "spark_count(c1)",
+       "spark_count(c2)",
+       "spark_count(c3)",
+       "spark_count(c4)"},
+      "SELECT c0, count(1), count(c1), count(c2), count(c3), count(c4) "
+      "FROM tmp GROUP BY c0");
+}
