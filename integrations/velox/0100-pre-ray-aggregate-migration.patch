+  auto values = makeFlatVector<int64_t>(valueRows, DECIMAL(10, 2));
+  std::vector<RowVectorPtr> data{makeRowVector({groups, values})};
+  createDuckDbTable(data);
+
+  std::atomic<int32_t> injections{0};
+  SCOPED_TESTVALUE_SET(
