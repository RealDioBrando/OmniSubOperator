+#include "velox/exec/tests/utils/AssertQueryBuilder.h"
+#include "velox/exec/tests/utils/PlanBuilder.h"
+#include "velox/functions/lib/aggregates/tests/utils/AggregationTestBase.h"
+#include "velox/functions/sparksql/aggregates/Register.h"
+
+using namespace facebook::velox::exec::test;
+using namespace facebook::velox::functions::aggregate::test;
+
+namespace facebook::velox::functions::aggregate::sparksql::test {
+
+namespace {
+
+constexpr const char* kKernelConfig = "omni_subop.count_enabled";
+
+class CountAggregateIntegrationTest : public AggregationTestBase {
+ protected:
+  void SetUp() override {
+    AggregationTestBase::SetUp();
+    registerAggregateFunctions("spark_", true);
+  }
+
+  void testBothPaths(
+      const std::vector<RowVectorPtr>& data,
+      const std::vector<std::string>& groupingKeys,
+      const std::vector<std::string>& aggregates,
+      const std::string& duckDbSql) {
+    for (const auto* enabled : {"false", "true"}) {
+      testAggregations(
+          data,
+          groupingKeys,
+          aggregates,
+          duckDbSql,
+          {{kKernelConfig, enabled}});
+    }
+  }
+};
+
+TEST_F(CountAggregateIntegrationTest, encodingsAndPartialMerge) {
+  constexpr vector_size_t kRows = 20;
+  auto groups = makeFlatVector<int32_t>(
+      kRows, [](auto row) { return static_cast<int32_t>(row % 4); });
+  auto flat = makeNullableFlatVector<int64_t>(
+      {0,
+       1,
+       std::nullopt,
+       3,
+       4,
+       std::nullopt,
+       6,
+       7,
+       8,
+       std::nullopt,
+       10,
+       11,
+       12,
+       13,
+       std::nullopt,
+       15,
+       16,
+       17,
+       18,
+       std::nullopt});
+
+  auto dictionaryBase =
+      makeNullableFlatVector<int64_t>({1, std::nullopt, 3, 4});
+  auto dictionary = BaseVector::wrapInDictionary(
+      nullptr,
+      makeIndices(
+          kRows, [](auto row) { return static_cast<vector_size_t>(row % 4); }),
+      kRows,
+      dictionaryBase);
+  auto constant = BaseVector::createConstant(BIGINT(), int64_t(9), kRows, pool());
+  auto nullConstant = BaseVector::createNullConstant(BIGINT(), kRows, pool());
+
+  std::vector<RowVectorPtr> data{makeRowVector(
+      {groups, flat, dictionary, constant, nullConstant})};
+  createDuckDbTable(data);
+
+  testBothPaths(
+      data,
+      {"c0"},
+      {"spark_count(c1)",
+       "spark_count(c2)",
+       "spark_count(c3)",
+       "spark_count(c4)",
+       "spark_count()"},
+      "SELECT c0, count(c1), count(c2), count(c3), count(c4), count(*) "
+      "FROM tmp GROUP BY c0");
+
+  testBothPaths(
+      data,
+      {},
+      {"spark_count(c1)",
+       "spark_count(c2)",
+       "spark_count(c3)",
+       "spark_count(c4)",
+       "spark_count()"},
+      "SELECT count(c1), count(c2), count(c3), count(c4), count(*) "
+      "FROM tmp");
+}
+
+TEST_F(CountAggregateIntegrationTest, sparseSelection) {
+  constexpr vector_size_t kRows = 32;
+  auto groups = makeFlatVector<int32_t>(
+      kRows, [](auto row) { return static_cast<int32_t>(row % 8); });
+  std::vector<std::optional<int64_t>> valueRows;
+  valueRows.reserve(kRows);
+  for (vector_size_t row = 0; row < kRows; ++row) {
+    valueRows.emplace_back(
+        row % 5 == 0 ? std::nullopt
+                     : std::optional<int64_t>(static_cast<int64_t>(row)));
+  }
+  auto values = makeNullableFlatVector<int64_t>(valueRows);
+  std::vector<VectorPtr> children{groups, values};
+  std::vector<RowVectorPtr> data{makeRowVector(children)};
+  createDuckDbTable(data);
+
+  auto makeSource = [&](PlanBuilder& builder) {
+    builder.values(data).filter("c0 % 3 = 0");
+  };
+
+  for (const auto* enabled : {"false", "true"}) {
+    testAggregations(
+        makeSource,
+        {"c0"},
+        {"spark_count(c1)", "spark_count()"},
+        "SELECT c0, count(c1), count(*) FROM tmp "
+        "WHERE c0 % 3 = 0 GROUP BY c0",
+        {{kKernelConfig, enabled}});
+
+    testAggregations(
+        makeSource,
+        {},
+        {"spark_count(c1)", "spark_count()"},
+        "SELECT count(c1), count(*) FROM tmp WHERE c0 % 3 = 0",
+        {{kKernelConfig, enabled}});
+  }
+}
+
+} // namespace
+} // namespace facebook::velox::functions::aggregate::sparksql::test
